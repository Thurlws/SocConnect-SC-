# Server-only settings. Copy what you need into .env.local (git ignores it), never into .env:
# .env is committed and must only hold public values.

# Live video calls (LiveKit Cloud → your project → Settings → API keys).
# Without all three, calls show "not available".
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI recaps, captions and recommendations via the Lovable AI gateway (set automatically when hosted on Lovable).
# Without it, recaps fall back to a basic keyword summary.
LOVABLE_API_KEY=

# Only for the local database (bun run db:start prints these). Bypasses row-level security, so keep it server-side.
# SUPABASE_SERVICE_ROLE_KEY=
