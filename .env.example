# Copy to .env for local development. Never commit .env.

# Live video calls (LiveKit Cloud → your project → Settings → API keys).
# Without all three, calls fall back to simulated participants.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI call recaps via the Lovable AI gateway (set automatically when hosted on Lovable).
# Without it, recaps fall back to a basic keyword summary.
LOVABLE_API_KEY=
